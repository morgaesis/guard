# Self-contained adversarial harness for consequence gating.
# Builds guard for Linux, sets up a capability-bounded non-root daemon, dedicated
# child account, and unprivileged agent, then runs the attack script. The harness
# uses deterministic local fixtures and makes no external service calls.
#
# Build context is the repo root. `.dockerignore` restricts the context to the
# source and fixture paths this harness copies.
FROM docker.io/library/rust@sha256:77fac8b98f9f46062bb680b6d25d5bcaabfc400143952ebc572e924bcbedc3fa

WORKDIR /src
ARG CARGO_BUILD_JOBS=2
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}
# Copy only what the build needs (keeps the Windows target/ out of the image).
# `tests/` is required so `run.sh test` actually compiles and runs the
# integration test binaries (e.g. mcp_integration) - without it the suite
# silently covers only the lib/bin unit tests. `examples/` is required because
# policy_tests embeds example policy files via include_str!("../examples/...").
COPY Cargo.toml Cargo.lock build.rs deny.toml ./
COPY src ./src
COPY config ./config
COPY tests ./tests
COPY examples ./examples
COPY .github/dependabot.yml ./.github/dependabot.yml
COPY .github/workflows/dependabot-automerge.yml .github/workflows/dependabot-enable-automerge.yml ./.github/workflows/

RUN cargo test --release --locked --quiet --no-run \
    && install -m 0755 target/release/guard /usr/local/bin/guard

# Four distinct identities: the operator, two agents, and the untrusted child.
# The daemon runs as guarddaemon with the production CAP_SETUID/CAP_SETGID
# capability pair so it can initialize and select the fixed child identity.
RUN groupadd -g 2000 guard-clients \
    && useradd -m -u 1000 guarddaemon \
    && useradd -m -u 1001 agent \
    && useradd -m -u 1002 other-agent \
    && useradd -m -u 1003 guardexec \
    && usermod -aG guard-clients guarddaemon \
    && usermod -aG guardexec guarddaemon \
    && usermod -aG guard-clients agent \
    && usermod -aG guard-clients other-agent

# Catalog validation binds fixed file arguments to trusted ancestors. The
# attack fixture replaces `/work` with its own bounded filesystem before
# daemon startup; synthetic scenarios retain these immutable image anchors.
RUN install -d -o root -g root -m 0755 /work /work/ansible-project

# The daemon's immutable authority mountpoint is anchored directly under the
# read-only container rootfs, outside every daemon-writable ancestor.
RUN install -d -o root -g root -m 0555 /authority

# The shared catalog also binds synthetic Ansible coverage to this canonical
# project directory. Synthetic runs replace `/scenario` with their private
# fixture volume; the fixed run only needs the trusted path to exist at load.
RUN install -d -o root -g root -m 0755 /scenario /scenario/ansible

COPY ctf/gating/verbs.yaml /etc/guard/verbs.yaml
RUN chmod 0644 /etc/guard/verbs.yaml
COPY ctf/gating/attack.sh /attack.sh
RUN chmod 0755 /attack.sh
COPY ctf/gating/synthetic-user.sh /synthetic-user.sh
RUN chmod 0755 /synthetic-user.sh
COPY ctf/gating/fake-llm.rs /tmp/fake-llm.rs
RUN rustc /tmp/fake-llm.rs -o /usr/local/bin/guard-fake-llm \
    && rm /tmp/fake-llm.rs

# Default: run the adversarial attack. Use the harness script's `test` mode to
# run the full Linux test suite with the entrypoint overridden.
ENTRYPOINT ["/attack.sh"]
