# Self-contained adversarial harness for consequence gating.
# Builds guard for Linux, sets up an unprivileged daemon (uid 1000) and agent (uid 1001),
# and runs the attack script. The harness uses deterministic local fixtures and
# makes no external service calls.
#
# Build context is the repo root. `.dockerignore` restricts the context to the
# source and fixture paths this harness copies.
FROM docker.io/library/rust@sha256:77fac8b98f9f46062bb680b6d25d5bcaabfc400143952ebc572e924bcbedc3fa

WORKDIR /src
ARG CARGO_BUILD_JOBS=2
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}
# Copy only what the build needs (keeps the Windows target/ out of the image).
# `tests/` is required so `run.sh test` actually compiles and runs the
# integration test binaries (e.g. mcp_integration) - without it the suite
# silently covers only the lib/bin unit tests. `examples/` is required because
# policy_tests embeds example policy files via include_str!("../examples/...").
COPY Cargo.toml Cargo.lock build.rs deny.toml ./
COPY src ./src
COPY config ./config
COPY tests ./tests
COPY examples ./examples

# The registry, git checkouts, and target directory live in build cache mounts
# so a rebuild after a source change reuses every unchanged dependency instead
# of compiling the whole tree again. The build runs in /src/target itself
# because the test binaries bake that path in at compile time through
# CARGO_BIN_EXE_guard. The finished target is copied into the image, and
# /src/target then points at the copy, because `run.sh test` and the
# synthetic-user scenarios run the compiled test binaries from /src/target at
# container run time, where no cache mount exists.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/src/target,sharing=locked \
    cargo test --release --locked --quiet --no-run \
    && install -m 0755 target/release/guard /usr/local/bin/guard \
    && cp -a /src/target /src/target-image
RUN rm -rf /src/target && ln -s /src/target-image /src/target

# Three distinct identities: the daemon/operator (uid 1000) and two agents
# (uids 1001 and 1002). Peer credentials keep their authority separate.
RUN useradd -m -u 1000 guarddaemon \
    && useradd -m -u 1001 agent \
    && useradd -m -u 1002 other-agent

COPY ctf/gating/verbs.yaml /etc/guard/verbs.yaml
RUN chmod 0644 /etc/guard/verbs.yaml
COPY ctf/gating/attack.sh /attack.sh
RUN chmod 0755 /attack.sh
COPY ctf/gating/synthetic-user.sh /synthetic-user.sh
RUN chmod 0755 /synthetic-user.sh
COPY ctf/gating/fake-llm.rs /tmp/fake-llm.rs
RUN rustc /tmp/fake-llm.rs -o /usr/local/bin/guard-fake-llm \
    && rm /tmp/fake-llm.rs

# Default: run the adversarial attack. Use the harness script's `test` mode to
# run the full Linux test suite with the entrypoint overridden.
ENTRYPOINT ["/attack.sh"]
