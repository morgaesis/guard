[Unit]
Description=guard server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=guard
Group=guard
# Membership in the worker's validated private group lets the daemon create
# 0640 proxy client files that only guard and guard-exec can read.
SupplementaryGroups=guard-clients guard-exec
WorkingDirectory=/var/lib/guard
EnvironmentFile=-/etc/default/guard
# Daemon-owned configuration discovery uses this private home. Brokered
# commands receive the dedicated guard-exec account's home instead.
Environment=HOME=/var/lib/guard
# A numeric fail-closed default keeps the service startable before an operator
# configures the authenticated agent UID list in /etc/default/guard.
Environment=GUARD_ALLOWED_UIDS=0
RuntimeDirectory=guard
RuntimeDirectoryMode=0755
StateDirectory=guard
StateDirectoryMode=0700
UMask=0077
# GUARD_ALLOWED_UIDS contains only UID[,UID...]. Keeping --users outside the
# expansion makes systemd pass the option and its value as separate arguments.
# The admin token reaches the daemon only through stdin: systemd opens the
# root-held token file and hands over the descriptor, so the value never
# enters the daemon's environment, argv, or a file its brokered children can
# read. Approved commands run as guard-exec, a distinct account with no access
# to daemon state. Per-run credentials and temporary read grants are refused in
# this shared-UID mode. Provision the admin token once as root:root 0400; see
# DEPLOYMENT.md.
StandardInput=file:/etc/guard/admin.token
ExecStart=/usr/local/bin/guard server start --socket /run/guard/guard.sock --socket-group guard-clients --state-db /var/lib/guard/state.db --users ${GUARD_ALLOWED_UIDS} --exec-user guard-exec --admin-token-stdin
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
# The daemon needs only CAP_SETUID and CAP_SETGID to initialize supplementary
# groups and switch approved processes to guard-exec. It clears both capabilities
# in the child before execve. Fixed mode does not materialize child-owned secret
# files or temporary caller-file ACLs, so CAP_CHOWN, CAP_FOWNER, and
# CAP_DAC_READ_SEARCH are deliberately absent.
AmbientCapabilities=CAP_SETUID CAP_SETGID
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/guard /var/lib/guard /var/lib/guard-exec

[Install]
WantedBy=multi-user.target
