# guard systemd service environment
# Install to /etc/default/guard
#
# This file covers the variables relevant to the packaged systemd unit, which
# serves local clients over a UNIX socket. See .env.example in the repository
# root for the complete variable catalog.

# --- Required ---

# Authenticated local agent UIDs, comma-separated. The packaged unit defaults
# to UID 0 and therefore rejects ordinary agents until this list is configured.
GUARD_ALLOWED_UIDS=0

# LLM API key for command evaluation.
GUARD_LLM_API_KEY=

# --- Optional (defaults shown) ---

# Emit startup paths and runtime configuration to the systemd journal.
RUST_LOG=info

# LLM endpoint URL.
# GUARD_LLM_API_URL=https://openrouter.ai/api/v1/chat/completions

# Primary model for command evaluation.
# GUARD_LLM_MODEL=openai/gpt-5.6-luna
# Hidden-reasoning effort per evaluator call: minimal|low|medium|high|max.
# GUARD_LLM_REASONING_EFFORT=high

# Optional fallback chain (comma-separated). When set, takes precedence over
# GUARD_LLM_MODEL above.
# GUARD_LLM_MODELS=openai/gpt-5.6-luna,meta-llama/llama-4-maverick

# Evaluation mode: readonly, safe, or paranoid.
# GUARD_MODE=readonly

# LLM call timeout in seconds.
# GUARD_LLM_TIMEOUT=30

# Command and evaluator admission limits.
# GUARD_COMMAND_MAX_CONCURRENCY=32
# GUARD_COMMAND_PRINCIPAL_CONCURRENCY=8
# GUARD_COMMAND_EVALUATOR_MAX_CONCURRENCY=4
# GUARD_COMMAND_EVALUATOR_PRINCIPAL_CONCURRENCY=2
# GUARD_COMMAND_EVALUATOR_RATE_PER_MINUTE=60
# GUARD_COMMAND_EVALUATOR_BURST=10
# GUARD_COMMAND_EVALUATOR_ERROR_THRESHOLD=3
# GUARD_COMMAND_EVALUATOR_CIRCUIT_COOLDOWN=60

# Path to additive prompt file (appended to the base prompt).
# GUARD_PROMPT_APPEND=

# Immutable operator-owned verb catalog and its runtime lock. Set both values
# together; the packaged daemon loads the catalog once and disables promotion.
# GUARD_VERBS=/etc/guard/verbs.yaml
# GUARD_IMMUTABLE_VERBS_LOCK=/run/guard/verbs.lock

# Over the unit's Unix socket, admin RPCs require the root-held token supplied
# through stdin by the service unit. The Windows SYSTEM operator rule does not
# apply on Unix. GUARD_AUTH_TOKEN applies only to TCP listeners, which this unit
# does not use (see .env.example).
