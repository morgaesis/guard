#!/bin/sh
set -eu

# Administrative RPCs on a local Guard socket accept only the active daemon
# uid. Refuse ambiguous service state instead of guessing an identity.
standard_state=$(systemctl is-active guard.service 2>/dev/null || true)
caller_state=$(systemctl is-active guard-exec-as-caller.service 2>/dev/null || true)
if [ "$standard_state" = active ] && [ "$caller_state" != active ]; then
  exec runuser --user guard -- /usr/local/bin/guard "$@" --socket /run/guard/guard.sock
fi
if [ "$caller_state" = active ] && [ "$standard_state" != active ]; then
  exec /usr/local/bin/guard "$@" --socket /run/guard/guard.sock
fi
echo 'guard-operator requires exactly one active packaged Guard service' >&2
exit 1
